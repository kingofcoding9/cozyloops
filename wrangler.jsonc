{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cozy-loops",
  "main": "worker.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "STRIPE_CURRENCY": "usd"
  }
}
